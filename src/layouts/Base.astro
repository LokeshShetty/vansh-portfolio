---
// The only web font: Inter as one variable file (weight + optical size),
// self-hosted from Fontsource. Only the latin file is preloaded; the other
// subsets load on demand via unicode-range and the page never uses them.
// Headings use the opsz 32 cut, which is Inter Display.
import "@fontsource-variable/inter/opsz.css";
import interLatin from "@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url";
// Accent face for a few words ("grows things.", "touch"): Instrument Serif
// italic, latin only (~20 KB). Preloaded because the tagline is above the fold.
import "@fontsource/instrument-serif/latin-400-italic.css";
import serifItalic from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import "@/styles/globals.css";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { profile } from "@/data/profile";

const title = `${profile.name}, ${profile.role}`;
const description = profile.intro;
const ogImage = new URL("/og.png", Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f3ef" />
    <script is:inline>
      // Apply a saved dark-theme choice before first paint. Light is default.
      try {
        if (localStorage.getItem("theme") === "dark")
          document.documentElement.dataset.theme = "dark";
      } catch {}
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href={interLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={serifItalic}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
  </head>
  <body>
    <div class="progress" aria-hidden="true"></div>
    <ThemeToggle />
    <slot />
  </body>
</html>
