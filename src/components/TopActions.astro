---
// The fixed header on every page: page links on the left (Home, My Videos)
// and, on the right, "Get in touch" (to the contact card in the footer),
// "Get my Book" (Amazon) and the theme toggle.
import { book } from "@/data/profile";
import ThemeToggle from "./ThemeToggle.astro";
import styles from "./TopActions.module.css";

const path = Astro.url.pathname;
// `short` is the label on phones, where three links share the row with the
// buttons.
const pages = [
  { label: "Home", short: "Home", href: "/", current: path === "/" },
  {
    label: "My Videos",
    short: "Videos",
    href: "/videos/",
    current: path.startsWith("/videos"),
  },
  {
    label: "Other Work",
    short: "Other",
    href: "/other-work/",
    current: path.startsWith("/other-work"),
  },
];
---

<header class={styles.bar}>
  <nav class={styles.nav} aria-label="Pages">
    {pages.map((p) => (
      <a
        class={styles.page}
        href={p.href}
        aria-label={p.label}
        aria-current={p.current ? "page" : undefined}
      >
        <span class={styles.full}>{p.label}</span>
        <span class={styles.short} aria-hidden="true">
          {p.short}
        </span>
      </a>
    ))}
  </nav>

  <div class={styles.actions}>
    <a
      class:list={[styles.pill, styles.primary, styles.contact]}
      href="#contact"
      aria-label="Get in touch"
      data-track="contact_click"
      data-from="top-bar"
    >
      <span class={styles.label}>Get in touch</span>
      <svg
        class={styles.icon}
        viewBox="0 0 24 24"
        width="16"
        height="16"
        aria-hidden="true"
      >
        <path
          d="M3 6h18v12H3zM3 6l9 7 9-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linejoin="round"
        />
      </svg>
    </a>
    {book.href && (
      <a
        class:list={[styles.pill, styles.book]}
        href={book.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Get my Book (Amazon)"
        data-track="link_click"
        data-from="top-bar-book"
      >
        <span class={styles.label}>
          Get my Book <span aria-hidden="true">↗</span>
        </span>
        <svg
          class={styles.icon}
          viewBox="0 0 24 24"
          width="16"
          height="16"
          aria-hidden="true"
        >
          <path
            d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5zM5 19.5A1.5 1.5 0 0 0 6.5 21H19"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )}
    <ThemeToggle />
  </div>
</header>
