---
// Canvas for the interactive Three.js cuboid (src/three/cuboid.ts). Astro
// bundles the script below; three.js itself is split into its own hashed
// chunk and only downloaded once the page has loaded and gone idle. Skipped
// for reduced motion, Save-Data and browsers without WebGL 2, which simply
// see the section without it.
import styles from "./Cuboid.module.css";

type Props = { class?: string };
---

<div class:list={[styles.wrap, Astro.props.class]} data-cuboid>
  <canvas class={styles.canvas} aria-hidden="true"></canvas>
  <p class:list={["eyebrow", styles.hint]} aria-hidden="true" data-cuboid-hint>
    Drag to turn · Click to light up
  </p>
</div>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-cuboid]");
  const canvas = wrap?.querySelector("canvas");
  const ok =
    canvas &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches &&
    !(navigator as Navigator & { connection?: { saveData?: boolean } })
      .connection?.saveData &&
    !!document.createElement("canvas").getContext("webgl2");

  if (canvas && ok) {
    const go = () =>
      import("../three/cuboid")
        .then(({ mount }) => mount(canvas))
        .catch(() => {});
    const idle = () =>
      "requestIdleCallback" in window
        ? requestIdleCallback(go, { timeout: 2500 })
        : setTimeout(go, 1200);
    if (document.readyState === "complete") idle();
    else addEventListener("load", idle, { once: true });
  }
</script>
