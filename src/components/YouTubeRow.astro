---
// A row of YouTube videos, all the same height: each tile's width grows in
// proportion to its aspect ratio, so 16:9 films and 9:16 Shorts line up.
// Until a tile scrolls into view it's just the video's thumbnail; then the
// player loads and plays muted on loop (src/lib/youtube.ts). On phones the
// row stacks: films full width, Shorts two across.
import type { YouTubeVideo } from "@/data/videos";
import styles from "./YouTubeRow.module.css";

type Props = { videos: YouTubeVideo[]; class?: string };

const { videos } = Astro.props;
---

<div class:list={[styles.row, Astro.props.class]}>
  {videos.map((v) => (
    <div
      class:list={["reveal", styles.tile, styles[v.shape]]}
      data-yt={v.id}
      data-shape={v.shape}
    >
      <img
        class={styles.poster}
        src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
        alt=""
        loading="lazy"
        decoding="async"
        width="480"
        height="360"
      />
      <div class={styles.bar}>
        <a
          class={styles.open}
          href={
            v.shape === "portrait"
              ? `https://www.youtube.com/shorts/${v.id}`
              : `https://www.youtube.com/watch?v=${v.id}`
          }
          target="_blank"
          rel="noopener noreferrer"
          data-track="link_click"
          data-from="video-youtube"
        >
          Open on YouTube <span aria-hidden="true">↗</span>
        </a>
        <button
          type="button"
          class={styles.sound}
          data-yt-sound
          aria-pressed="false"
          aria-label="Sound"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor" />
            <g
              class={styles.off}
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M16 9.5l5 5M21 9.5l-5 5" />
            </g>
            <g
              class={styles.on}
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M15.5 9a4.5 4.5 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11" />
            </g>
          </svg>
        </button>
      </div>
    </div>
  ))}
</div>

<script>
  import "@/lib/youtube";
</script>
