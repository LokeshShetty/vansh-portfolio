---
// A small round button over a muted autoplaying video that turns its sound
// on and off. Wired up in src/lib/autoplay.ts.
---

<button
  type="button"
  class="sound"
  data-sound
  aria-pressed="false"
  aria-label="Sound"
>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z" fill="currentColor"></path>
    <g
      class="off"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M16 9.5l5 5M21 9.5l-5 5"></path>
    </g>
    <g
      class="on"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
    >
      <path d="M15.5 9a4.5 4.5 0 0 1 0 6M18.5 6.5a8 8 0 0 1 0 11"></path>
    </g>
  </svg>
</button>

<style>
  .sound {
    position: absolute;
    right: var(--space-s);
    bottom: var(--space-s);
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: #fff;
    background: rgb(0 0 0 / 0.55);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: transform 0.2s var(--ease-out);
  }

  .sound:hover {
    transform: scale(1.08);
  }

  .sound:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .sound[aria-pressed="true"] {
    color: var(--accent-ink);
    background: var(--accent);
  }

  .sound[aria-pressed="false"] .on,
  .sound[aria-pressed="true"] .off {
    display: none;
  }
</style>
