---
// Light is the default. The toggle switches to dark and remembers it; the
// inline script in Base.astro applies a saved choice before first paint, so
// there's no flash of the wrong theme. Where the View Transitions API is
// available, the new theme wipes in as a circle from the button.
import styles from "./ThemeToggle.module.css";
---

<button
  type="button"
  class={styles.toggle}
  data-theme-toggle
  aria-label="Dark theme"
  aria-pressed="false"
>
  <svg
    class={styles.moon}
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <path
      d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linejoin="round"
    ></path>
  </svg>
  <svg
    class={styles.sun}
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
  >
    <circle
      cx="12"
      cy="12"
      r="4"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
    ></circle>
    <path
      d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    ></path>
  </svg>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector("[data-theme-toggle]");
    const meta = document.querySelector('meta[name="theme-color"]');
    const sync = () => {
      const dark = root.dataset.theme === "dark";
      button.setAttribute("aria-pressed", String(dark));
      meta.setAttribute("content", dark ? "#0a0b0d" : "#f3f3ef");
    };
    const apply = (dark) => {
      if (dark) root.dataset.theme = "dark";
      else delete root.dataset.theme;
      try {
        localStorage.setItem("theme", dark ? "dark" : "light");
      } catch {}
      sync();
    };
    button.addEventListener("click", (event) => {
      const dark = root.dataset.theme !== "dark";
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!document.startViewTransition || still) return apply(dark);
      // The new theme spreads out in a circle from the button.
      const r = button.getBoundingClientRect();
      const x = event.clientX || r.left + r.width / 2;
      const y = event.clientY || r.top + r.height / 2;
      const end = Math.hypot(
        Math.max(x, innerWidth - x),
        Math.max(y, innerHeight - y),
      );
      document
        .startViewTransition(() => apply(dark))
        .ready.then(() => {
          root.animate(
            {
              clipPath: [
                `circle(0px at ${x}px ${y}px)`,
                `circle(${end}px at ${x}px ${y}px)`,
              ],
            },
            {
              duration: 650,
              easing: "cubic-bezier(0.22, 1, 0.36, 1)",
              pseudoElement: "::view-transition-new(root)",
            },
          );
        });
    });
    sync();
  })();
</script>
