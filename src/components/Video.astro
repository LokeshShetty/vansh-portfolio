---
// A muted, looping video that plays while on screen (src/lib/autoplay.ts),
// with a sound toggle. preload="none": only the poster loads with the page.
// The poster is the image in src/assets/media with the same name.
import { getImage } from "astro:assets";
import type { VideoSlot } from "@/data/profile";
import { getMedia } from "@/lib/media";
import Asset from "./Asset.astro";
import SoundToggle from "./SoundToggle.astro";
import styles from "./Video.module.css";

type Props = VideoSlot & { class?: string };

const { name, alt, src, ratio = "16 / 9", class: className } = Astro.props;
const image = getMedia(name);
const poster =
  src && image
    ? await getImage({
        src: image,
        format: "webp",
        width: Math.min(image.width, 960),
      })
    : undefined;
---

{src && image && poster ? (
  <div class:list={[styles.wrap, className]}>
    <video
      class={styles.video}
      style={{ aspectRatio: ratio }}
      src={src}
      poster={poster.src}
      aria-label={alt}
      width={image.width}
      height={image.height}
      preload="none"
      muted
      loop
      playsinline
      data-autoplay
    />
    <SoundToggle />
  </div>
) : (
  <Asset {...Astro.props} />
)}

<script>
  import "@/lib/autoplay";
</script>
