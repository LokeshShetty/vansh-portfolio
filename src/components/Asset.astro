---
// Build-time <picture>: AVIF, then WebP, at several widths, with real
// dimensions (no layout shift). Ships zero JavaScript. An asset that hasn't
// been added yet renders as an empty frame of the same shape, so the layout
// doesn't move when it arrives.
import { Picture } from "astro:assets";
import type { AssetSlot } from "@/data/profile";
import { getMedia, widthsFor } from "@/lib/media";
import styles from "./Asset.module.css";

type Props = AssetSlot & {
  /** Matches the column width the image sits in, so the browser picks the right file. */
  sizes?: string;
  /** Above-the-fold images only: loads eagerly at high priority. */
  priority?: boolean;
  /** 1–100. Defaults to the site-wide setting in astro.config.mjs. */
  quality?: number;
  class?: string;
};

const {
  name,
  alt,
  ratio = "16 / 10",
  sizes = "(min-width: 64rem) 36rem, 100vw",
  priority = false,
  quality,
  class: className,
} = Astro.props;
const image = getMedia(name);
---

{image ? (
  <Picture
    src={image}
    alt={alt}
    formats={["avif", "webp"]}
    fallbackFormat="webp"
    widths={widthsFor(image)}
    sizes={sizes}
    quality={quality}
    loading={priority ? "eager" : "lazy"}
    fetchpriority={priority ? "high" : "auto"}
    decoding="async"
    class={styles.img}
    pictureAttributes={{
      class: [styles.frame, className].filter(Boolean).join(" "),
    }}
  />
) : (
  <div
    class:list={[styles.frame, styles.placeholder, className]}
    style={{ aspectRatio: ratio }}
    role="img"
    aria-label={`${alt} (coming soon)`}
  >
    <span class={styles.label}>{name}</span>
  </div>
)}
