---
// Every video, at /videos/: YouTube films and Shorts in rows of equal
// height (they play muted on loop as they come into view), then the
// Instagram reels. The list lives in src/data/videos.ts.
import Base from "@/layouts/Base.astro";
import Reels from "@/components/Reels.astro";
import YouTubeRow from "@/components/YouTubeRow.astro";
import Footer from "@/sections/Footer.astro";
import { reels, videoCount, videoRows } from "@/data/videos";
import work from "@/styles/work.module.css";
import styles from "@/styles/videos.module.css";
---

<Base
  title="Video work"
  description="Films, YouTube Shorts and Instagram reels from Vansh Agicha's work"
>
  <main class:list={["shell", work.page]}>
    <a href="/" class={work.back}>
      <span aria-hidden="true">←</span> Home
    </a>

    <header class:list={["tile", work.header]}>
      <p class="eyebrow">{videoCount} videos</p>
      <h1 class:list={["display", work.title]}>Video work</h1>
      <p class={work.summary}>
        Films, Shorts and reels from my work. They play muted; turn the sound on
        for any one of them
      </p>
    </header>

    <section class={styles.rows} aria-label="Films and Shorts">
      {videoRows.map((row) => (
        <YouTubeRow videos={row} />
      ))}
    </section>

    <section class={styles.reels} aria-labelledby="reels-title">
      <div class={styles.reelsHead}>
        <h2 id="reels-title" class="display">
          On Instagram
        </h2>
        <p class="chip">{reels.length} reels</p>
      </div>
      <Reels />
    </section>
  </main>
  <Footer />
</Base>
