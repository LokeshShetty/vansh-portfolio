---
// My Videos, at /videos/: every YouTube film and Short, in rows of equal
// height. They play muted on loop as they come into view. The list lives
// in src/data/videos.ts.
import Base from "@/layouts/Base.astro";
import YouTubeRow from "@/components/YouTubeRow.astro";
import Footer from "@/sections/Footer.astro";
import { videoCount, videoRows } from "@/data/videos";
import work from "@/styles/work.module.css";
import styles from "@/styles/videos.module.css";
---

<Base
  title="My Videos"
  description="Films and YouTube Shorts from Vansh Agicha's work"
>
  <main class:list={["shell", work.page, styles.page]}>
    <header class:list={["tile", work.header]}>
      <p class="eyebrow">{videoCount} videos</p>
      <h1 class:list={["display", work.title]}>My Videos</h1>
      <p class={work.summary}>
        Films and Shorts from my work. They play muted; turn the sound on for
        any one of them
      </p>
    </header>

    <section class={styles.rows} aria-label="Films and Shorts">
      {videoRows.map((row) => (
        <YouTubeRow videos={row} />
      ))}
    </section>
  </main>
  <Footer />
</Base>
