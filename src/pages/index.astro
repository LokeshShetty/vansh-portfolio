---
import Base from "@/layouts/Base.astro";
import Hero from "@/sections/Hero.astro";
import Brands from "@/sections/Brands.astro";
import Statement from "@/sections/Statement.astro";
import WorkVideo from "@/sections/WorkVideo.astro";
import CaseStudy from "@/sections/CaseStudy.astro";
import CaseRow from "@/sections/CaseRow.astro";
import ProductMarketing from "@/sections/ProductMarketing.astro";
import Products from "@/sections/Products.astro";
import Book from "@/sections/Book.astro";
import Background from "@/sections/Background.astro";
import Footer from "@/sections/Footer.astro";
import { getCollection } from "astro:content";
import { profile } from "@/data/profile";
import styles from "@/styles/page.module.css";

const caseStudies = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);
// Featured projects get large split cards; the rest form an accordion list.
const featured = caseStudies.filter((s) => s.data.featured);
const others = caseStudies.filter((s) => !s.data.featured);
const number = (s: (typeof caseStudies)[number]) => caseStudies.indexOf(s) + 1;

const personJsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  sameAs: profile.links.flatMap((l) => (l.href ? [l.href] : [])),
};
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(personJsonLd)}
  />
  <main>
    <Hero />
    <Brands />
    <Statement />
    <WorkVideo />
    <section
      id="work"
      class:list={["shell", styles.work]}
      aria-labelledby="work-title"
    >
      <div class={styles.heading}>
        <h2 id="work-title" class="display lift">
          <span>Selected work</span>
        </h2>
        <p class="chip reveal">
          {String(caseStudies.length).padStart(2, "0")} projects
        </p>
      </div>
      {featured.map((study, i) => (
        <CaseStudy study={study} index={number(study)} flip={i % 2 === 1} />
      ))}
      {others.length > 0 && (
        <div class={styles.list}>
          {others.map((study) => (
            <CaseRow study={study} index={number(study)} />
          ))}
        </div>
      )}
    </section>
    <ProductMarketing />
    <Products />
    <Book />
    <Background />
  </main>
  <Footer />
</Base>
