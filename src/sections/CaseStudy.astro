---
import Asset from "@/components/Asset.astro";
import Text from "@/components/Text.astro";
import Video from "@/components/Video.astro";
import type { CaseStudy } from "@/data/profile";
import styles from "./CaseStudy.module.css";

type Props = { study: CaseStudy; index: number };

const { study, index } = Astro.props;
const hasAssets = study.assets.length > 0;

// "9 / 16" → true. Portrait media is capped so a reel doesn't fill a phone screen.
const isTall = (ratio = "") => {
  const [w, h] = ratio.split("/").map(Number);
  return h > w;
};
const mediaClass = (ratio?: string) =>
  [styles.item, isTall(ratio) ? styles.tall : ""].join(" ");
---

<article
  id={study.id}
  class:list={["tile", styles.study, !hasAssets && styles.textOnly]}
  aria-labelledby={`${study.id}-title`}
>
  <div class={styles.copy}>
    <div class:list={[styles.head, "reveal"]}>
      <span class:list={["display", styles.index]} aria-hidden="true">
        {String(index).padStart(2, "0")}
      </span>
      <p class="eyebrow">{study.kicker}</p>
    </div>
    <h3
      id={`${study.id}-title`}
      class:list={["display", styles.title, "reveal"]}
    >
      <Text text={study.title} />
    </h3>
    <p class:list={[styles.summary, "reveal"]}>{study.summary}</p>
    <ul class:list={[styles.did, "reveal"]}>
      {study.did.map((item) => (
        <li>
          <Text text={item} />
        </li>
      ))}
    </ul>
    <dl class={styles.results}>
      {study.results.map((r, i) => (
        <div
          class:list={[styles.result, "reveal", "stagger"]}
          style={{ "--i": i }}
        >
          <dt class={styles.label}>{r.label}</dt>
          <dd class:list={["display", styles.value]}>
            <Text text={r.value} />
          </dd>
        </div>
      ))}
    </dl>
  </div>

  {hasAssets && (
    <div class={styles.media}>
      {study.assets.map((asset) =>
        "src" in asset ? (
          <Video {...asset} class={mediaClass(asset.ratio)} />
        ) : (
          <Asset {...asset} class={mediaClass(asset.ratio)} />
        ),
      )}
    </div>
  )}
</article>
