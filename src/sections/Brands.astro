---
import { brands, channels } from "@/data/profile";
import styles from "./Brands.module.css";
// Two rows that scroll continuously in opposite directions: brands on
// top, channels below. Each row is doubled so it never shows a gap; screen
// readers skip the copies.
const rows = [
  { label: "Brands and stages", items: brands, reverse: false },
  { label: "Channels", items: channels, reverse: true },
];
---

<section class={styles.band} aria-label="Brands and channels">
  {rows.map((row) => (
    <div
      class:list={[styles.track, row.reverse && styles.reverse]}
      aria-label={row.label}
      role="group"
    >
      {[0, 1].map((copy) => (
        <ul
          class:list={[styles.row, row.reverse && styles.alt]}
          aria-hidden={copy === 1 ? "true" : undefined}
        >
          {row.items.map((b) => (
            <li>{b}</li>
          ))}
        </ul>
      ))}
    </div>
  ))}
</section>
