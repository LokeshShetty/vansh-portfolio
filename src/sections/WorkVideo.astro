---
// The work-experience video: a large muted, looping player that plays while
// on screen, with a sound control. With `video.youtube` set it's a YouTube
// player (src/lib/youtube.ts), which adapts quality to the connection;
// otherwise the file in `video.src` (src/lib/autoplay.ts), of which only the
// cover loads with the page. With neither, a placeholder frame.
import { getImage } from "astro:assets";
import Asset from "@/components/Asset.astro";
import SoundToggle from "@/components/SoundToggle.astro";
import YouTubeRow from "@/components/YouTubeRow.astro";
import { video } from "@/data/profile";
import { getMedia } from "@/lib/media";
import styles from "./WorkVideo.module.css";

const cover = getMedia(video.name);
const poster =
  video.src && cover
    ? await getImage({
        src: cover,
        format: "webp",
        width: Math.min(cover.width, 1600),
        quality: 80,
      })
    : undefined;
---

<section class:list={["shell", styles.section]} aria-labelledby="video-title">
  <div class={styles.head}>
    <p class="eyebrow">{video.kicker}</p>
    <h2 id="video-title" class:list={["display", "lift", styles.title]}>
      <span>{video.title}</span>
    </h2>
    <div class={styles.copy}>
      {video.copy.map((line) => (
        <p>{line}</p>
      ))}
      {video.aside && <p class={styles.aside}>{video.aside}</p>}
    </div>
  </div>

  {video.youtube ? (
    <YouTubeRow videos={[{ id: video.youtube, shape: "landscape" }]} />
  ) : (
    <div
      class:list={[styles.player, "reveal"]}
      data-player
      style={{ aspectRatio: video.ratio }}
    >
      {video.src ? (
        <>
          <video
            class={styles.video}
            src={video.src}
            poster={poster?.src}
            preload="none"
            muted
            loop
            playsinline
            data-autoplay
            aria-label={video.alt}
          />
          <SoundToggle />
        </>
      ) : (
        <>
          <Asset
            {...video}
            class={styles.cover}
            sizes="(min-width: 80rem) 76rem, 100vw"
          />
          <span class={styles.soon} aria-hidden="true">
            <svg viewBox="0 0 24 24" width="28" height="28">
              <path d="M8 5.5v13l11-6.5z" fill="currentColor" />
            </svg>
          </span>
        </>
      )}
    </div>
  )}
</section>

<script>
  import "@/lib/autoplay";
</script>
