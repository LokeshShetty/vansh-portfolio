---
// One big sentence that lights up word by word as it scrolls through the
// viewport. CSS only: every word reads the section's named view timeline and
// starts a little later than the one before it. Without scroll-timeline
// support (or with reduced motion) the sentence is simply shown in full.
import { profile } from "@/data/profile";
import styles from "./Statement.module.css";

// "*marketing manager*" → accent words.
const words = profile.statement.split(/(\*[^*]+\*)/).flatMap((part) =>
  part.startsWith("*")
    ? part
        .slice(1, -1)
        .split(" ")
        .map((text) => ({ text, accent: true }))
    : part
        .split(" ")
        .filter(Boolean)
        .map((text) => ({ text, accent: false })),
);
// Word i lights up over its own slice of the section's journey into view;
// the last word is fully dark by 40% of the way, before the sentence reaches
// the middle of the screen. Computed here as plain percentages, so the CSS
// needs no custom properties (an earlier --n here clashed with the
// registered, non-inheriting --n of the count-up and broke every word).
const range = (i: number) => {
  const start = 8 + (28 * i) / words.length;
  return `cover ${start.toFixed(2)}% cover ${(start + 4).toFixed(2)}%`;
};
---

<section class:list={["shell", styles.statement]} aria-label="In short">
  <p class={styles.text}>
    {words.map((w, i) => (
      <>
        <span
          class:list={[styles.word, w.accent && styles.accent]}
          style={{ "animation-range": range(i) }}
        >
          {w.text}
        </span>{" "}
      </>
    ))}
  </p>
</section>
