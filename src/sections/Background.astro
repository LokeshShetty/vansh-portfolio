---
// Experience as a vertical timeline and the toolkit as clusters of chips.
// Deliberately open (no tiles), to contrast with the card-heavy sections
// above.
import { experience, toolkit } from "@/data/profile";
import styles from "./Background.module.css";
---

<section id="about" class:list={["shell", styles.grid]} aria-label="Background">
  <div>
    <h2 class:list={["display", "lift", styles.heading]}>
      <span>Experience</span>
    </h2>
    <ol class={styles.timeline}>
      {experience.map((item, i) => (
        <li
          class:list={[styles.stop, i === 0 && styles.now, "reveal", "stagger"]}
          style={{ "--i": i }}
        >
          <span class={styles.when}>{item.when}</span>
          <p class={styles.role}>{item.role}</p>
          <p class={styles.org}>{item.org}</p>
          {item.note && <p class={styles.note}>{item.note}</p>}
        </li>
      ))}
    </ol>
  </div>

  <div>
    <h2 class:list={["display", "lift", styles.heading]}>
      <span>Toolkit</span>
    </h2>
    <div class={styles.clusters}>
      {toolkit.map((t, i) => (
        <div
          class:list={[styles.cluster, "reveal", "stagger"]}
          style={{ "--i": i }}
        >
          <p class="eyebrow">{t.group}</p>
          <ul class={styles.chips}>
            {t.items.split(" · ").map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
