---
import { experience, toolkit } from "@/data/profile";
import styles from "./Background.module.css";
---

<section id="about" class:list={["shell", styles.grid]} aria-label="Background">
  <div class="tile reveal">
    <h2 class:list={["display", "lift", styles.heading]}>
      <span>Experience</span>
    </h2>
    <ol class={styles.list}>
      {experience.map((item) => (
        <li class={styles.row}>
          <span class={styles.when}>{item.when}</span>
          <div>
            <p class={styles.role}>{item.role}</p>
            <p class={styles.org}>{item.org}</p>
            {item.note && <p class={styles.note}>{item.note}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
  <div class="tile reveal">
    <h2 class:list={["display", "lift", styles.heading]}>
      <span>Toolkit</span>
    </h2>
    <dl class={styles.list}>
      {toolkit.map((t) => (
        <div class={styles.tool}>
          <dt class={styles.role}>{t.group}</dt>
          <dd class={styles.note}>{t.items}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
